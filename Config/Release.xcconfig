#include "Base.xcconfig"

APP_BUNDLE_ID = io.github.iamadarshh.mullion
APP_PRODUCT_NAME = Mullion
APP_DISPLAY_NAME = Mullion

// NFR-3
ENABLE_HARDENED_RUNTIME = YES

SWIFT_OPTIMIZATION_LEVEL = -O
SWIFT_COMPILATION_MODE = wholemodule
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym

// No Local.xcconfig here: a developer's local signing identity must never override
// release signing (Developer ID, decided in M3; see docs/RELEASING.md).
